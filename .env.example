# Copy to .env and adjust. Loaded automatically by src/config/env.js.

NODE_ENV=development
PORT=3000

# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# --- Database: choose ONE of the two forms below ---

# 1. A full connection string. Takes precedence when set.
#    Note: naming a database in the path also makes it the authentication
#    database, so a root user needs authSource=admin appended.
MONGODB_URI=mongodb://127.0.0.1:27017/nodejs-hit

# 2. Separate parts, as most hosting platforms publish them. Used only when
#    MONGODB_URI is absent. DB_AUTH_SOURCE defaults to admin.
# DB_HOST=
# DB_PORT=27017
# DB_NAME=
# DB_USER=
# DB_PASS=
# DB_AUTH_SOURCE=admin
